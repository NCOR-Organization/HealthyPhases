    obo:IAO_0000115 "Gerotranscendence Ontology (GERO)" ;
    dcterms:contributor <https://orcid.org/0000-0002-1118-1738> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
    oboInOwl:inSubset obo:PHASES_0002010 .

obo:PHASES_0000021 a owl:Class ;
    rdfs:label "elective solitude disposition"@en ;
    dcterms:contributor <https://orcid.org/0000-0001-6906-5548>,
        <https://orcid.org/0000-0001-9625-1899>,
        <https://orcid.org/0000-0002-1118-1738>,
        <https://orcid.org/0009-0002-7282-0836> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
    oboInOwl:inSubset obo:PHASES_0002012 ;
    rdfs:subClassOf obo:MF_0000033 ;
    skos:definition "A mental disposition that, if realized, is realized in intentionally withdrawing from social interaction in order to pursue self-reflection, restoration, or personal goals."@en ;
    skos:prefLabel "elective solitude" .

obo:PHASES_0000022 a owl:Class ;
    rdfs:label "imposed solitude characteristic"@en ;
    dcterms:contributor <https://orcid.org/0000-0001-6906-5548>,
        <https://orcid.org/0000-0001-9625-1899>,
        <https://orcid.org/0000-0002-1118-1738>,
        <https://orcid.org/0009-0002-7282-0836> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
    oboInOwl:inSubset obo:PHASES_0002012 ;
    rdfs:subClassOf obo:BFO_0000020 ;
    skos:definition "A characteristic of a person that is physically or socially alone due to external constraints or circumstances, and not by personal choice."@en ;
    skos:prefLabel "imposed solitude" .

obo:PHASES_0000023 a owl:Class ;
    rdfs:label "ambient sociability disposition"@en ;
    dcterms:contributor <https://orcid.org/0000-0001-6906-5548>,
        <https://orcid.org/0000-0001-9625-1899>,
        <https://orcid.org/0000-0002-1118-1738>,
        <https://orcid.org/0009-0002-7282-0836> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
    oboInOwl:inSubset obo:PHASES_0002012 ;
    rdfs:subClassOf obo:MF_0000033 ;
    skos:definition "A mental disposition that is realized in retaining the sense of social presence without direct social engagement with others in a public or semi-public space."@en ;
    skos:prefLabel "ambient sociability" .

obo:PHASES_0000025 a owl:Class ;
    rdfs:label "successful aging construct information content entity"@en ;
    dcterms:contributor <https://orcid.org/0000-0001-6906-5548>,
        <https://orcid.org/0000-0001-9625-1899>,
        <https://orcid.org/0000-0002-1118-1738>,
        <https://orcid.org/0009-0002-7282-0836> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
    oboInOwl:inSubset obo:PHASES_0002010,
        obo:PHASES_0002012 ;
    rdfs:subClassOf obo:PHASES_0000008 ;
    skos:definition "A psychological construct information content entity that describes achieving physical health, cognitive vitality, and continued involvement with life, as measured against individual and cultural standards of aging well."@en ;
    skos:prefLabel "successful aging construct" .

obo:PHASES_0000026 a owl:Class ;
    rdfs:label "aloneliness disposition"@en ;
    dcterms:contributor <https://orcid.org/0000-0001-6906-5548>,
        <https://orcid.org/0000-0001-9625-1899>,
        <https://orcid.org/0000-0002-1118-1738>,
        <https://orcid.org/0009-0002-7282-0836> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
    dcterms:description "Aloneliness is conceptualized as the negative feelings that arise from the perception that one is not spending enough time alone." ;
    oboInOwl:inSubset obo:PHASES_0002012 ;
    rdfs:subClassOf obo:MF_0000033 ;
    skos:definition "A mental disposition that, if realized, is realized in experiencing discomfort or distress due to a perceived lack of desired time alone."@en ;
    skos:prefLabel "aloneliness" .

obo:PHASES_0000027 a owl:Class ;
    rdfs:label "social detachment disposition"@en ;
    dcterms:contributor <https://orcid.org/0000-0001-6906-5548>,
        <https://orcid.org/0000-0001-9625-1899>,
        <https://orcid.org/0000-0002-1118-1738>,
        <https://orcid.org/0009-0002-7282-0836> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
    dcterms:description "When a person socialy withdrawls, he or she retreats from interpersonal relationships, usually accompanied by an attitude of indifference, detachment, and aloofness. Social withdrawal is often associated with disorders such as schizophrenia, autism spectrum disorder, and depression." ;
    oboInOwl:inSubset obo:PHASES_0002012 ;
    rdfs:subClassOf obo:MF_0000033 ;
    skos:definition "A mental disposition that, if realized, is realized in reduced motivation to engage in or maintain social relationships, often without distress or social fear."@en ;
    skos:prefLabel "social detachment" .

obo:PHASES_0000028 a owl:Class ;
    rdfs:label "shyness behavior disposition"@en ;
    dcterms:contributor <https://orcid.org/0000-0001-6906-5548>,
        <https://orcid.org/0000-0001-9625-1899>,
        <https://orcid.org/0000-0002-1118-1738>,
        <https://orcid.org/0009-0002-7282-0836> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
    oboInOwl:inSubset obo:PHASES_0002012 ;
    rdfs:subClassOf obo:MF_0000033 ;
    skos:definition "A mental disposition to social anxiety that, if realized, is realized in the inhibition of behavior during potential social interaction due to fear of negative evaluation."@en ;
    skos:prefLabel "shyness" .

obo:PHASES_0000029 a owl:Class ;
    rdfs:label "solitude affinity disposition"@en ;
    dcterms:contributor <https://orcid.org/0000-0001-6906-5548>,
        <https://orcid.org/0000-0001-9625-1899>,
        <https://orcid.org/0000-0002-1118-1738>,
        <https://orcid.org/0009-0002-7282-0836> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
    oboInOwl:inSubset obo:PHASES_0002012 ;
    rdfs:subClassOf obo:MF_0000033 ;
    skos:definition "A mental disposition that, if realized, is realized in seeking out and enjoying time spent alone for reflection, creativity, or restoration."@en ;
    skos:prefLabel "solitude affinity" .

obo:PHASES_0000034 a owl:NamedIndividual ;
    rdfs:label "Narrative Identity Indicators of Self-Transcendence"@en ;
    dcterms:contributor <https://orcid.org/0000-0002-1118-1738> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
