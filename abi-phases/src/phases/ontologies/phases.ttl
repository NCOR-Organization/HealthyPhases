    oboInOwl:inSubset obo:PHASES_0002010 ;
    skos:altLabel "NADA"@en .

obo:PHASES_0000038 a owl:Class ;
    rdfs:label "narrative identity quality"@en ;
    obo:IAO_0000115 "A personal identity quality consisting of the internalized, evolving, story of oneself that individuals construct to make sense and meaning out of life."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-6906-5548>,
        <https://orcid.org/0000-0001-9625-1899>,
        <https://orcid.org/0000-0002-1118-1738>,
        <https://orcid.org/0009-0002-7282-0836> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
    oboInOwl:inSubset obo:PHASES_0002010,
        obo:PHASES_0002012 ;
    rdfs:subClassOf obo:PHASES_0000036 .

obo:PHASES_0000040 a owl:NamedIndividual ;
    rdfs:label "The Non-attachment to Self Scale"@en ;
    obo:IAO_0000115 "Gerotranscendence Ontology (GERO)" ;
    dcterms:contributor <https://orcid.org/0000-0002-1118-1738> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
    oboInOwl:inSubset obo:PHASES_0002010 .

obo:PHASES_0000042 a owl:Class ;
    rdfs:label "anxious solitude construct information content entity"@en ;
    obo:IAO_0000115 "A psychological construct that is putatively about biologically-based dispositions to avoid others due to social fears and anxieties"@en ;
    dcterms:contributor <https://orcid.org/0000-0001-6906-5548>,
        <https://orcid.org/0000-0001-9625-1899>,
        <https://orcid.org/0000-0002-1118-1738>,
        <https://orcid.org/0009-0002-7282-0836> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
    oboInOwl:inSubset obo:PHASES_0002012 ;
    rdfs:comment "How are behavioral inhibition and anxious-solitude related to and distinct from solitude? (anxious-solitude, and behavioral inhibition are all constructs reflecting biologically-based dispositions to avoid others due to social fears and anxieties)"@en ;
    rdfs:subClassOf obo:PHASES_0000008 ;
    skos:prefLabel "anxious solitude construct" .

