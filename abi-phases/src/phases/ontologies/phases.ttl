obo:RO_0001900 a owl:AnnotationProperty ;
    rdfs:isDefinedBy <http://humanbehaviourchange.org/ontology/bcio.owl> .

obo:RO_0002092 a owl:ObjectProperty ;
    rdfs:label "happens during" ;
    obo:IAO_0000115 "X happens_during Y iff: (start(Y) before_or_simultaneous_with start(X)) AND (end(X) before_or_simultaneous_with end(Y))" ;
    rdfs:domain obo:BFO_0000003 ;
    rdfs:isDefinedBy <http://humanbehaviourchange.org/ontology/bcio.owl> ;
    rdfs:range obo:BFO_0000003 .

obo:RO_0002161 a owl:AnnotationProperty ;
    rdfs:label "never in taxon" ;
    obo:IAO_0000112 "tooth SubClassOf 'never in taxon' value 'Aves'" ;
    obo:IAO_0000115 "x never in taxon T if and only if T is a class, and x does not instantiate the class expression \"in taxon some T\". Note that this is a shortcut relation, and should be used as a hasValue restriction in OWL." ;
    obo:IAO_0000117 <https://orcid.org/0000-0002-6601-2165> ;
    obo:IAO_0000119 <http://www.ncbi.nlm.nih.gov/pubmed/17921072>,
        <http://www.ncbi.nlm.nih.gov/pubmed/20973947> ;
    obo:IAO_0000425 "Class: ?X DisjointWith: RO_0002162 some ?Y " ;
    obo:OMO_0002000 """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX in_taxon: <http://purl.obolibrary.org/obo/RO_0002162>
PREFIX never_in_taxon: <http://purl.obolibrary.org/obo/RO_0002161>
CONSTRUCT {
  in_taxon: a owl:ObjectProperty .
  ?x owl:disjointWith [
    a owl:Restriction ;
    owl:onProperty in_taxon: ;
    owl:someValuesFrom ?taxon
  ] .
  ?x rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty in_taxon: ;
    owl:someValuesFrom [
      a owl:Class ;
      owl:complementOf ?taxon
    ]
  ] .
}
WHERE {
  ?x never_in_taxon: ?taxon .
}""" ;
    rdfs:isDefinedBy obo:ro.owl ;
    rdfs:seeAlso <https://github.com/obophenotype/uberon/wiki/Taxon-constraints> ;
    rdfs:subPropertyOf obo:RO_0002172 .

obo:phases.owl a owl:Ontology ;
    dcterms:contributor <https://orcid.org/0000-0001-6906-5548>,
        <https://orcid.org/0000-0001-9189-9661>,
        <https://orcid.org/0000-0001-9625-1899>,
        <https://orcid.org/0000-0002-1118-1738>,
        <https://orcid.org/0000-0002-2999-0103>,
        <https://orcid.org/0000-0003-2294-3571>,
        <https://orcid.org/0009-0002-7282-0836>,
        <https://orcid.org/0009-0009-9778-4641> ;
    dcterms:description "PHASES provides an ontology for integrating research in solitude and gerotranscendence. By integrating these areas of study, we aim to deepen our understanding of each and how they promote healthy aging." ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:title "Promoting Health Aging through Semantic Enrichment of Solitude Research (PHASES) Ontology" ;
    owl:versionIRI <http://purl.obolibrary.org/obo/phases/releases/2026-02-25/phases.owl> ;
    owl:versionInfo "2026-02-25" .

<http://purl.obolibrary.org/obo/phases.owl/PHASES_0000051> a owl:Class ;
    rdfs:label "social isolation process"@en ;
    obo:IAO_0000115 "A process in which an individual objectively lacks social connection such that there is little or no opportunity for social interaction."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-6906-5548>,
        <https://orcid.org/0000-0001-9625-1899>,
        <https://orcid.org/0000-0002-1118-1738>,
        <https://orcid.org/0009-0002-7282-0836> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
    oboInOwl:inSubset obo:PHASES_0002012 ;
    rdfs:subClassOf obo:BFO_0000015 ;
    skos:prefLabel "social isolation state" .

<http://purl.obolibrary.org/obo/phases.owl/PHASES_0000052> a owl:NamedIndividual ;
    rdfs:label "UCLA Loneliness Scale"@en ;
    obo:IAO_0000115 "Solitude Ontology (SOLO)",
        "The Likert scale designed to assess an individual's subjective feelings of loneliness and social isolation, as well as perceived disconnects between desired and actual social relationships." ;
    dcterms:contributor <https://orcid.org/0000-0002-1118-1738> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
    oboInOwl:inSubset obo:PHASES_0002012 .

<http://purl.obolibrary.org/obo/phases.owl/PHASES_0000053> a owl:NamedIndividual ;
    rdfs:label "Positive Solitude Scale"@en ;
    obo:IAO_0000115 "The Likert scale designed to assess the degree to which individuals experience solitude as a beneficial, reflecting dimensions such as emotional restoration, creativity, inner peace, and personal growth in the absence of social interaction." ;
    dcterms:contributor <https://orcid.org/0000-0002-1118-1738> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
    oboInOwl:inSubset obo:PHASES_0002012 .

<http://purl.obolibrary.org/obo/phases.owl/PHASES_0000054> a owl:NamedIndividual ;
    rdfs:label "reminiscence therapy"@en ;
    obo:IAO_0000115 "Gerotranscendence Ontology (GERO)",
        "The behaviour change intervention that uses life histories to improve well-being" ;
    dcterms:contributor <https://orcid.org/0000-0002-1118-1738> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
    oboInOwl:inSubset obo:PHASES_0002010 .

<http://purl.obolibrary.org/obo/phases.owl/PHASES_0000055> a owl:Class ;
    rdfs:label "need for a sense of belonging to a community"@en ;
    obo:IAO_0000115 "A psychological need to feel connected to and accepted by a group."@en ;
    dcterms:contributor <https://orcid.org/0000-0002-1118-1738> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
    oboInOwl:inSubset obo:PHASES_0002010 ;
    rdfs:subClassOf <http://humanbehaviourchange.org/ontology/BCIO_006064> .

