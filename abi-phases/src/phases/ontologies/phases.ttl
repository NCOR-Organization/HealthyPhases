obo:RO_0002506 a owl:ObjectProperty ;
    rdfs:label "causal relation between entities" ;
    obo:IAO_0000116 "The intent is that the process branch of the causal property hierarchy is primary (causal relations hold between occurrents/processes), and that the material branch is defined in terms of the process branch" ;
    obo:IAO_0000117 <https://orcid.org/0000-0002-6601-2165> ;
    obo:IAO_0000119 <http://purl.obolibrary.org/obo/ro/docs/causal-relations> ;
    obo:IAO_0000232 "Do not use this relation directly. It is intended as a grouping for a diverse set of relations, all involving cause and effect." ;
    rdfs:domain obo:BFO_0000001 ;
    rdfs:isDefinedBy <http://humanbehaviourchange.org/ontology/bcio.owl> ;
    rdfs:range obo:BFO_0000001 ;
    rdfs:subPropertyOf obo:RO_0002410 .

<http://purl.obolibrary.org/obo/phases.owl/PHASES_0000050> a owl:Class ;
    rdfs:label "transcendence disposition"@en ;
    obo:IAO_0000115 "A  mental disposition borne by agents such that, if realized, is realized in shifting in goals, values, and attachments towards connections to past and future generations and in seeking coherence in one’s life narrative."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-6906-5548>,
        <https://orcid.org/0000-0001-9625-1899>,
        <https://orcid.org/0000-0002-1118-1738>,
        <https://orcid.org/0009-0002-7282-0836> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
    oboInOwl:inSubset obo:PHASES_0002010 ;
    rdfs:subClassOf obo:MF_0000033 ;
    skos:prefLabel "transcendence" .

