obo:IAO_0000409 a owl:Class ;
    rdfs:label "denotator type",
        "denotator type"@en ;
    obo:IAO_0000111 "denotator type"@en ;
    obo:IAO_0000112 "The Basic Formal Ontology ontology makes a distinction between Universals and defined classes, where the formal are \"natural kinds\" and the latter arbitrary collections of entities.",
