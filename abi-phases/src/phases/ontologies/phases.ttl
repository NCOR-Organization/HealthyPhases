obo:PHASES_0000007 a owl:Class ;
    rdfs:label "self-efficacy representational pattern quality"@en ;
    dcterms:contributor <https://orcid.org/0000-0001-6906-5548>,
        <https://orcid.org/0000-0001-9625-1899>,
        <https://orcid.org/0000-0002-1118-1738>,
        <https://orcid.org/0009-0002-7282-0836> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
    oboInOwl:inSubset obo:PHASES_0002010,
        obo:PHASES_0002012 ;
    rdfs:subClassOf obo:PHASES_0000006 ;
    skos:definition "A self-appraisal representational pattern quality consisting of an evaluation of the agent's capability to achieve objectives or satisfy desires."@en .

obo:PHASES_0000009 a owl:Class ;
    rdfs:label "psychoanalytic psychological identity construct information content entity"@en ;
    dcterms:contributor <https://orcid.org/0000-0001-6906-5548>,
        <https://orcid.org/0000-0001-9625-1899>,
        <https://orcid.org/0000-0002-1118-1738>,
        <https://orcid.org/0009-0002-7282-0836> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
    oboInOwl:inSubset obo:PHASES_0002010,
        obo:PHASES_0002012 ;
    rdfs:subClassOf obo:PHASES_0000008 ;
    skos:definition "A psychological construct in which it is hypothesized that human consciousness consists of the id, ego, and superego."@en ;
    skos:prefLabel "psychoanalytic psychological identity construct" .

obo:PHASES_0000010 a owl:Class ;
    rdfs:label "performative identity quality"@en ;
    dcterms:contributor <https://orcid.org/0000-0001-6906-5548>,
        <https://orcid.org/0000-0001-9625-1899>,
        <https://orcid.org/0000-0002-1118-1738>,
        <https://orcid.org/0009-0002-7282-0836> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
    oboInOwl:inSubset obo:PHASES_0002010,
        obo:PHASES_0002012 ;
    rdfs:subClassOf obo:PHASES_0000036 ;
    skos:definition "A personal identity quality formed as a result of the agent's performative behaviors as influencing and influenced by the formation of one's psychological identity."@en .

obo:PHASES_0000011 a owl:Class ;
    rdfs:label "social withdrawal disposition"@en ;
    dcterms:contributor <https://orcid.org/0000-0001-6906-5548>,
        <https://orcid.org/0000-0001-9625-1899>,
        <https://orcid.org/0000-0002-1118-1738>,
        <https://orcid.org/0009-0002-7282-0836> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
    oboInOwl:inSubset obo:PHASES_0002012 ;
    rdfs:subClassOf obo:MF_0000033 ;
    skos:definition "A mental disposition that, if realized, is realized in the consistent avoidance of social interactions with both familiar and unfamiliar peers due to psychological traits such as social fear or anxiety."@en ;
    skos:prefLabel "social withdrawal" .

obo:PHASES_0000016 a owl:NamedIndividual ;
    rdfs:label "Self-Transcendence Scale"@en ;
    obo:IAO_0000115 "Gerotranscendence Ontology (GERO)" ;
    dcterms:contributor <https://orcid.org/0000-0002-1118-1738> ;
    dcterms:created "2025-06-14T22:20:08Z" ;
