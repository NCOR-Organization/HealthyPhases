@prefix phases-label: <http://purl.obolibrary.org/obo/phases/labels.owl#> .
@prefix phases-doc: <http://purl.obolibrary.org/obo/phases/documents.owl#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@base <http://purl.obolibrary.org/obo/phases/labels.owl> .

<http://purl.obolibrary.org/obo/phases/labels.owl> rdf:type owl:Ontology ;
  owl:imports <http://purl.obolibrary.org/obo/bfo/2020/bfo-core.ttl> ;
  owl:imports <http://purl.obolibrary.org/obo/phases/documents.owl> ;
  rdfs:label "PHASES Labels Ontology"@en .

#################################################################
#    Classes
#################################################################

phases-label:ExtractedLabel rdf:type owl:Class ;
  rdfs:subClassOf obo:BFO_0000031 ;
  rdfs:label "extracted label"@en ;
  rdfs:comment "A topical label extracted from a text chunk by an LLM."@en .

#################################################################
#    Object Properties
#################################################################

phases-label:label_from_chunk rdf:type owl:ObjectProperty ;
  rdfs:domain phases-label:ExtractedLabel ;
  rdfs:range phases-doc:Chunk ;
  rdfs:label "label from chunk"@en ;
  rdfs:comment "Relates an extracted label to the chunk it was extracted from."@en .

#################################################################
#    Datatype Properties
#################################################################

phases-label:label_id rdf:type owl:DatatypeProperty ;
  rdfs:domain phases-label:ExtractedLabel ;
  rdfs:range xsd:string ;
  rdfs:label "label id"@en ;
  rdfs:comment "Identifier for the extracted label."@en .

phases-label:label_text rdf:type owl:DatatypeProperty ;
  rdfs:domain phases-label:ExtractedLabel ;
  rdfs:range xsd:string ;
  rdfs:label "label text"@en ;
  rdfs:comment "Natural-language topical label extracted from a chunk."@en .

phases-label:label_hash rdf:type owl:DatatypeProperty ;
  rdfs:domain phases-label:ExtractedLabel ;
  rdfs:range xsd:string ;
  rdfs:label "label hash"@en ;
  rdfs:comment "Stable hash to help deduplicate extracted labels."@en .

phases-label:label_number rdf:type owl:DatatypeProperty ;
  rdfs:domain phases-label:ExtractedLabel ;
  rdfs:range xsd:integer ;
  rdfs:label "label number"@en ;
  rdfs:comment "Ordinal position of the label in a chunk extraction result."@en .

phases-label:source_chunk_id rdf:type owl:DatatypeProperty ;
  rdfs:domain phases-label:ExtractedLabel ;
  rdfs:range xsd:string ;
  rdfs:label "source chunk id"@en ;
  rdfs:comment "Chunk identifier copied for easier querying and diagnostics."@en .

phases-label:generated_by_model rdf:type owl:DatatypeProperty ;
  rdfs:domain phases-label:ExtractedLabel ;
  rdfs:range xsd:string ;
  rdfs:label "generated by model"@en ;
  rdfs:comment "Name of the LLM used to generate the label."@en .

phases-label:prompt_version rdf:type owl:DatatypeProperty ;
  rdfs:domain phases-label:ExtractedLabel ;
  rdfs:range xsd:string ;
  rdfs:label "prompt version"@en ;
  rdfs:comment "Version tag for the extraction prompt used."@en .

phases-label:creation_time rdf:type owl:DatatypeProperty ;
  rdfs:domain phases-label:ExtractedLabel ;
  rdfs:range xsd:dateTime ;
  rdfs:label "creation time"@en ;
  rdfs:comment "Timestamp when the label extraction was persisted."@en .

#################################################################
#    SHACL Shapes
#################################################################

phases-label:ExtractedLabelShape rdf:type sh:NodeShape ;
  sh:targetClass phases-label:ExtractedLabel ;
  sh:property [
    sh:path phases-label:label_id ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path phases-label:label_text ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path phases-label:label_hash ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path phases-label:label_from_chunk ;
    sh:class phases-doc:Chunk ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path phases-label:creation_time ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
  ] ;
  rdfs:label "Extracted label shape"@en .
