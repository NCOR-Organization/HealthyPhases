@prefix phases-ax: <http://purl.obolibrary.org/obo/phases/axioms.owl#> .
@prefix phases-doc: <http://purl.obolibrary.org/obo/phases/documents.owl#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@base <http://purl.obolibrary.org/obo/phases/axioms.owl> .

<http://purl.obolibrary.org/obo/phases/axioms.owl> rdf:type owl:Ontology ;
  owl:imports <http://purl.obolibrary.org/obo/bfo/2020/bfo-core.ttl> ;
  owl:imports <http://purl.obolibrary.org/obo/phases/documents.owl> ;
  rdfs:label "PHASES Axioms Ontology"@en .

#################################################################
#    Classes
#################################################################

phases-ax:ExtractedAxiom rdf:type owl:Class ;
  rdfs:subClassOf obo:BFO_0000031 ;
  rdfs:label "extracted axiom"@en ;
  rdfs:comment "An axiom statement extracted from a text chunk by an LLM."@en .

#################################################################
#    Object Properties
#################################################################

phases-ax:axiom_from_chunk rdf:type owl:ObjectProperty ;
  rdfs:domain phases-ax:ExtractedAxiom ;
  rdfs:range phases-doc:Chunk ;
  rdfs:label "axiom from chunk"@en ;
  rdfs:comment "Relates an extracted axiom to the chunk it was extracted from."@en .

#################################################################
#    Datatype Properties
#################################################################

phases-ax:axiom_id rdf:type owl:DatatypeProperty ;
  rdfs:domain phases-ax:ExtractedAxiom ;
  rdfs:range xsd:string ;
  rdfs:label "axiom id"@en ;
  rdfs:comment "Identifier for the extracted axiom."@en .

phases-ax:axiom_text rdf:type owl:DatatypeProperty ;
  rdfs:domain phases-ax:ExtractedAxiom ;
  rdfs:range xsd:string ;
  rdfs:label "axiom text"@en ;
  rdfs:comment "Natural-language axiom text extracted from a chunk."@en .

phases-ax:axiom_hash rdf:type owl:DatatypeProperty ;
  rdfs:domain phases-ax:ExtractedAxiom ;
  rdfs:range xsd:string ;
  rdfs:label "axiom hash"@en ;
  rdfs:comment "Stable hash to help deduplicate extracted axioms."@en .

phases-ax:axiom_number rdf:type owl:DatatypeProperty ;
  rdfs:domain phases-ax:ExtractedAxiom ;
  rdfs:range xsd:integer ;
  rdfs:label "axiom number"@en ;
  rdfs:comment "Ordinal position of the axiom in a chunk extraction result."@en .

phases-ax:source_chunk_id rdf:type owl:DatatypeProperty ;
  rdfs:domain phases-ax:ExtractedAxiom ;
  rdfs:range xsd:string ;
  rdfs:label "source chunk id"@en ;
  rdfs:comment "Chunk identifier copied for easier querying and diagnostics."@en .

phases-ax:generated_by_model rdf:type owl:DatatypeProperty ;
  rdfs:domain phases-ax:ExtractedAxiom ;
  rdfs:range xsd:string ;
  rdfs:label "generated by model"@en ;
  rdfs:comment "Name of the LLM used to generate the axiom."@en .

phases-ax:prompt_version rdf:type owl:DatatypeProperty ;
  rdfs:domain phases-ax:ExtractedAxiom ;
  rdfs:range xsd:string ;
  rdfs:label "prompt version"@en ;
  rdfs:comment "Version tag for the extraction prompt used."@en .

phases-ax:creation_time rdf:type owl:DatatypeProperty ;
  rdfs:domain phases-ax:ExtractedAxiom ;
  rdfs:range xsd:dateTime ;
  rdfs:label "creation time"@en ;
  rdfs:comment "Timestamp when the axiom extraction was persisted."@en .

#################################################################
#    SHACL Shapes
#################################################################

phases-ax:ExtractedAxiomShape rdf:type sh:NodeShape ;
  sh:targetClass phases-ax:ExtractedAxiom ;
  sh:property [
    sh:path phases-ax:axiom_id ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path phases-ax:axiom_text ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path phases-ax:axiom_hash ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path phases-ax:axiom_from_chunk ;
    sh:class phases-doc:Chunk ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path phases-ax:creation_time ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
  ] ;
  rdfs:label "Extracted axiom shape"@en .
